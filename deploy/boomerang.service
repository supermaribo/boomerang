[Unit]
Description=Boomerang backup appliance
After=network.target

[Service]
Type=simple
User=boomerang
Group=boomerang
Environment=BOOMERANG_DATA_DIR=/var/lib/boomerang
Environment=BOOMERANG_LISTEN=0.0.0.0:8080
ExecStart=/usr/local/bin/boomerang
Restart=on-failure
RestartSec=3
# NoNewPrivileges must stay off so the boomerang user can run the limited
# passwordless sudo rules for /usr/local/sbin/boomerang-update and
# /usr/local/sbin/boomerang-tailscale.
ProtectSystem=strict
ProtectHome=true
# Data dir, postfix submit, sudo timestamp, and Tailscale files that always exist.
# Do not list /run/tailscale — systemd fails to start if that directory is missing.
ExecStartPre=+/bin/mkdir -p /var/lib/tailscale
ReadWritePaths=/var/lib/boomerang /var/spool/postfix/maildrop /var/spool/postfix/public /run/sudo /etc/default /var/lib/tailscale
PrivateTmp=true

[Install]
WantedBy=multi-user.target
